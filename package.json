{
  "name": "screenshot-plugin",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tailwind:options": "npx tailwindcss -i ./src/styles/options.tailwind.css -o ./src/options/options.css --minify",
    "tailwind:popup": "npx tailwindcss -i ./src/styles/popup.tailwind.css -o ./src/popup/popup.css --minify",
    "tailwind:build": "npm run tailwind:options && npm run tailwind:popup",
    "tailwind:watch:options": "npx tailwindcss -w -i ./src/styles/options.tailwind.css -o ./src/options/options.css --minify",
    "tailwind:watch:popup": "npx tailwindcss -w -i ./src/styles/popup.tailwind.css -o ./src/popup/popup.css --minify",
    "tailwind:watch": "npm run tailwind:watch:options",
    "dev": "npm run tailwind:build && vite",
    "build": "npm run tailwind:build && vite build",
    "preview": "npm run tailwind:build && vite preview",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write src/**/*.{ts,js,html,css,json}",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/cli": "^4.1.14",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.0.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "playwright": "^1.52.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.2.2",
    "webextension-polyfill": "^0.12.0"
  }
}
